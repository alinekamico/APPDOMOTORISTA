# Banco de dados
DATABASE_URL=mysql+pymysql://kami:kami@localhost:3306/kami_romaneios

# JWT
JWT_SECRET=troque-este-valor-em-producao-para-uma-chave-aleatoria-longa
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Reset de senha
PASSWORD_RESET_EXPIRE_MINUTES=30
APP_BASE_URL=http://localhost:3000

# CORS (lista separada por vírgula) e rate limiting (governança de TI)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
RATE_LIMIT_POR_MINUTO=100

# SMTP (Gmail com senha de app, conforme governança de TI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=KAMI CO. Romaneios

# Maps (adapter OpenRouteService - gratuito, sem cartao, cria chave so com e-mail em
# openrouteservice.org; opcional em dev, cai no adapter fake/haversine se ausente)
OPENROUTESERVICE_API_KEY=

# Integrações futuras (mantidas fora por padrão em dev/teste)
TMS_WEBHOOK_TOKEN=troque-este-token
# INTEGRATION_ADAPTER_MAPS: "fake" (haversine, padrão) ou "openrouteservice" (real)
INTEGRATION_ADAPTER_MAPS=fake
INTEGRATION_ADAPTER_UNO=stub
INTEGRATION_ADAPTER_NPS=stub

# Fonte de romaneios enquanto o TMS não existe:
#   manual       -> tela "Novo romaneio (simulação)" (padrão)
#   uno_replica  -> busca na réplica do UNO hospedada no Supabase (Postgres)
INTEGRATION_ADAPTER_ROMANEIO_SOURCE=manual
UNO_REPLICA_DATABASE_URL=

# Uploads locais (fotos/assinaturas) - em produção trocar por S3
UPLOAD_DIR=./uploads
